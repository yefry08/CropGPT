# ChannelForge — non-secret overrides only.
# API keys and OAuth tokens go in the OS keyring (Settings dialog, or `channelforge secrets set <name>`),
# never in this file.

# Where the app keeps config.json, jobs.db and logs (default: ~/.channelforge)
# CHANNELFORGE_HOME=

# Folder that holds the cloned engines (OpenMontage, stickman-video-director, tools)
# CHANNELFORGE_ENGINES=

# CI / headless only: secrets may be injected as env vars instead of the keyring.
# CHANNELFORGE_SECRET_OMNIROUTE_API_KEY=
# CHANNELFORGE_SECRET_OMNIROUTE_MGMT_TOKEN=
