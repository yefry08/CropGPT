# ChannelForge — non-secret overrides only. Copy to .env next to where you start the app.
# API keys and OAuth tokens go in the OS keyring (Settings dialog, or `channelforge secrets set <name>`),
# never in this file.

# Where the app keeps config.json, jobs.db, logs, projects and (packaged app) the engines folder.
# Default: ~/.channelforge
# CHANNELFORGE_HOME=

# Folder holding the cloned engines (OpenMontage, stickman-video-director, tools).
# Default: ../engines from source, $CHANNELFORGE_HOME/engines in the packaged app.
# CHANNELFORGE_ENGINES=

# Chrome/Chromium binary for Channel 2 renders, if it is not found automatically.
# CHROME=

# x264 preset for Channel 1 clip assembly (default: medium; "veryfast" for quicker drafts).
# CF_X264_PRESET=

# Headless / CI only: secrets may be injected as env vars instead of the keyring.
# Name = CHANNELFORGE_SECRET_ + the keyring name in upper case.
# CHANNELFORGE_SECRET_OMNIROUTE_API_KEY=
# CHANNELFORGE_SECRET_OMNIROUTE_MGMT_TOKEN=
