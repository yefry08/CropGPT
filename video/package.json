{
  "name": "contractor-ai-pitch",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture.ts",
    "prepare-assets": "node scripts/prepare.ts",
    "srt": "node scripts/srt.ts",
    "test-render": "remotion render src/index.ts TestScene out/test-scene.mp4",
    "render": "npm run prepare-assets && npm run srt && remotion render src/index.ts ContractorPitch out/contractor-ai-pitch.mp4 --codec h264",
    "build": "npm run capture; npm run render",
    "studio": "remotion studio src/index.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.535",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "playwright-core": "1.56.1",
    "typescript": "5.6.3"
  }
}
